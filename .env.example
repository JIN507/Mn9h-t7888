# Copy to .env and fill in. NEVER commit .env (it is gitignored).
# On Render, set these in the dashboard (sync: false vars in render.yaml).

# --- Core ---
SECRET_KEY=change-me
DATABASE_URL=sqlite:///bahith.db
# REDIS_URL=redis://localhost:6379/0   # leave unset locally: jobs run inline

# --- Admin bootstrap ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
ADMIN_NAME=مسؤول النظام

# --- External APIs (rotate per docs/KEY_ROTATION.md before reuse!) ---
AIORNOT_API_KEY=
SERPAPI_API_KEY=
ZENSERP_API_KEY=
XAI_API_KEY=
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
# path to the (gitignored) service-account json:
GOOGLE_APPLICATION_CREDENTIALS=

# --- Storage: Cloudflare R2 (private bucket + presigned URLs) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tahaqqaq-media
# STORAGE_BACKEND=imgbb     # rollback switch: force ImgBB hosting
# IMGBB_FALLBACK=false      # disable auto-fallback to ImgBB on R2 errors
# legacy fallback only — delete after R2 cutover:
IMGBB_API_KEY=

# --- Visual Verification Engine (Phase 3, Tier 1) ---
# Requires: pip install -r requirements-ml.txt (torch + timm, ~1.5 GB)
# VISUAL_VERIFY=true          # enable embedding pipeline + search post-filter

# --- Optional ---
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# RATELIMIT_ENABLED=true
# LOG_LEVEL=INFO

# --- Origin Engine (reverse-image "who published it first") ---
# TinEye API (paid) — crawl-date ordered matches. Engine skips it when empty.
TINEYE_API_KEY=
# DeepSeek — plans text pivots + writes the Arabic narrative. Optional.
# (DEAPSEAK_KEY / Deapseak_key are accepted aliases.)
DEEPSEEK_API_KEY=
# Agent loop (DeepSeek drives tools). false => deterministic engine only.
# Headless Chromium for TinEye/Bing websites (needs `playwright install chromium`).
BROWSER_SEARCH=true
# Engines get an expiring public ImgBB copy of the query image (presigned R2
# links are rejected by Yandex). none => send the R2 link as-is.
SEARCH_COPY=imgbb
# If the R2 bucket has public access enabled (r2.dev or custom domain), engines
# get the plain public URL instead and no ImgBB copy is needed.
R2_PUBLIC_BASE_URL=
# Bing website engine: off (its URL-paste flow stopped working headless).
BING_WEB=false
# Grok (xAI) X+web search as an agent tool. Needs credits on console.x.ai.
# Key is read from GROK_API_KEY (or grok_key), then XAI_API_KEY.
GROK_API_KEY=
GROK_SEARCH=true
GROK_MODEL=grok-4-fast
# YouTube Data API v3 (free key from Google Cloud; enable the API). Agent tool.
YOUTUBE_API_KEY=
# AIOrNot verdict on every origin search (uses AIORNOT_API_KEY). false => skip.
# Auto-crop the photo out of post screenshots before searching. false => off.
SCREENSHOT_CROP=true

# Google Lens answers "no results" for some files (e.g. AI-restored images) on any
# host. Google engines then retry with variants of the query: a small re-encoded
# copy (LENS_SMALL_COPY_PX, hosted on our storage / ImgBB), then an image CDN proxy
# ('wsrv' = https://wsrv.nl, 'none' to disable, or a template containing {url}).
LENS_SMALL_COPY_PX=512
# Optional: hosts Google is known to block outright (variants go first for them).

# Keypoint (SIFT + RANSAC) verification of variants: confirms cropped / AI-restored /
# recoloured copies of the same photo and rejects look-alike scenes. false => off.
GEOMETRIC_VERIFY=true
GEOM_MIN_INLIERS=30

# Origin v2 (ORIGIN_V2_PLAN.md) is the origin engine.
# Per-investigation budgets enforced by v2 (image / video).
ORIGIN_TIME_S=150
ORIGIN_TIME_S_VIDEO=200
ORIGIN_CREDITS=15
ORIGIN_CREDITS_VIDEO=22
ORIGIN_PAGES=90
ORIGIN_PAGES_VIDEO=120
# Quick search (البحث السريع): Lens exact + visual only, no LLM.
ORIGIN_QUICK_TIME_S=45
ORIGIN_QUICK_CREDITS=4
ORIGIN_QUICK_PAGES=24

# Operator gate: the one account that opens the app (never commit real values).
GATE_ENABLED=true
APP_LOGIN_USER=admin
APP_LOGIN_PASSWORD=change-me
