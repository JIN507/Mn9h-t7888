{$DOMAIN} {
    encode zstd gzip
    request_body {
        max_size 260MB
    }
    # job progress is streamed (SSE): never buffer it
    @events path /api/jobs/*/events
    reverse_proxy @events web:8000 {
        flush_interval -1
        transport http {
            read_timeout 10m
        }
    }
    reverse_proxy web:8000 {
        transport http {
            read_timeout 5m
        }
    }
}
